# ============================================================================
# GitHub Secrets Template
# Copie este arquivo para scripts/.secrets.env e preencha com os valores reais
# Uso: cp scripts/.secrets.env.example scripts/.secrets.env
# ============================================================================

# -----------------------------------------------------------------------------
# GitHub Authentication (usado pelo script update-secrets.sh)
# Crie um token em: https://github.com/settings/tokens
# Permissões necessárias: repo (Full control of private repositories)
# -----------------------------------------------------------------------------
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # gitleaks:allow

# -----------------------------------------------------------------------------
# Secrets do Repositório (serão enviados para o GitHub)
# -----------------------------------------------------------------------------

# Databricks - DEV
DATABRICKS_HOST_DEV=https://adb-xxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_SP_CLIENT_ID_DEV=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DATABRICKS_SP_SECRET_DEV=your-service-principal-secret-dev

# Databricks - PROD
DATABRICKS_HOST_PROD=https://adb-xxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_SP_CLIENT_ID_PROD=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DATABRICKS_SP_SECRET_PROD=your-service-principal-secret-prod

