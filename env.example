# =============================================================================
# Data Contracts - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# Usage: cp env.example .env

# =============================================================================
# Databricks Authentication (required for trigger, optional for apply)
# =============================================================================

# Databricks workspace URL (e.g., https://myworkspace.cloud.databricks.com)
DATABRICKS_HOST=

# Service Principal credentials (for job triggering)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Bundle variable for run_as in databricks.yaml
BUNDLE_VAR_sp_client_id=

# =============================================================================
# Microsoft Purview Authentication (required for publish commands)
# =============================================================================

# Purview account name (without .purview.azure.com)
PURVIEW_ACCOUNT_NAME=

# Azure AD App Registration credentials
PURVIEW_CLIENT_ID=
PURVIEW_CLIENT_SECRET=
PURVIEW_TENANT_ID=

# Purview entity types (defaults match Databricks UC scan types)
# PURVIEW_TABLE_TYPE_NAME=databricks_table
# PURVIEW_COLUMN_TYPE_NAME=databricks_table_column

# Qualified name prefix (must match your Purview scan configuration)
# PURVIEW_QUALIFIED_NAME_PREFIX=databricks://metastore/

# =============================================================================
# Application Settings (optional)
# =============================================================================

# Target environment: dev or prod (default: dev)
ENVIRONMENT=dev

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# =============================================================================
# Path Overrides (optional, for custom project layouts)
# =============================================================================

# Custom path to contracts folder (default: data_contracts/assets)
# CONTRACTS_PATH=/custom/path/to/contracts

# Custom path to src folder (default: scripts/src)
# SRC_PATH=/custom/path/to/src

